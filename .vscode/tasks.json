{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "app_name",
      "type": "promptString",
      "description": "Enter the name of the application (e.g., vector_add)"
    },
    {
      "id": "artifact_path",
      "type": "promptString",
      "description": "Enter the path for the artifact (e.g., experiments/artifacts/vector_add_bundle_...)"
    },
    {
      "id": "kernel_params",
      "type": "promptString",
      "description": "Enter kernel parameters (e.g., grid and block dimensions)",
      "default": "{\"grid_dim\": {\"x\": 1, \"y\": 1, \"z\": 1}, \"block_dim\": {\"x\": 32, \"y\": 1, \"z\": 1}, \"parameters\": []}"
    }
  ],
  "tasks": [
    {
      "label": "PTX: Run application",
      "type": "shell",
      "command": "uv run experiments/tools/runner.py experiments/apps/${input:app_name}/",
      "problemMatcher": []
    },
	{
	  "label": "PTX: Create artifact",
	  "type": "shell",
	  "command": "uv run experiments/tools/artifact.py experiments/build/${input:app_name}/ experiments/apps/${input:app_name}/src/",
	  "problemMatcher": []
	},
	{
	  "label": "PTX: Create plot",
	  "type": "shell",
	  "command": "uv run experiments/tools/plotter.py ${input:artifact_path}/",
	  "problemMatcher": []
	},
  {
    "label": "PTX: Create analysis",
    "type": "shell",
    "command": "cargo run --manifest-path ptx-analyser/Cargo.toml analyze-cfg --kernel-params '${input:kernel_params}' ${input:artifact_path}/main.ptx",
    "problemMatcher": []
  },
  {
    "label": "PTX: Create Control Flow Graph",
    "type": "shell",
    "command": "cargo run --manifest-path ptx-analyser/Cargo.toml build-cfg ${input:artifact_path}/main.ptx --html-output ${input:artifact_path}/cfg.html",
    "problemMatcher": []
  }
  ]
}