{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "bentr_config",
      "type": "promptString",
      "description": "Enter the path to the Rasmus configuration file (e.g., experiments/apps/vector_add/rasmus_config.json)"
    },
    {
      "id": "app_name",
      "type": "promptString",
      "description": "Enter the name of the application (e.g., vector_add)"
    },
    {
      "id": "artifact_path",
      "type": "promptString",
      "description": "Enter the path for the artifact (e.g., experiments/artifacts/vector_add_bundle_...)"
    },
    {
      "id": "kernel_params",
      "type": "promptString",
      "description": "Enter kernel parameters (e.g., grid and block dimensions)",
      "default": "{\"grid_dim\": {\"x\": 1, \"y\": 1, \"z\": 1}, \"block_dim\": {\"x\": 32, \"y\": 1, \"z\": 1}, \"parameters\": []}"
    },
    {
      "id": "cuda_path",
      "type": "promptString",
      "description": "Enter the path to the CUDA toolkit (e.g., ./experiments/apps/vector_add/src/main.cu)",
    },
    {
      "id": "cuda_args",
      "type": "promptString",
      "description": "Enter additional arguments for the CUDA application (e.g., --arg1 value1 --arg2 value2)",
      "default": ""
    },
    {
      "id": "ptx_path",
      "type": "promptString",
      "description": "Enter the path to the PTX file (e.g., ./experiments/artifacts/vector_add_bundle_.../main.ptx)",
    },
    {
      "id": "kernel_name",
      "type": "promptString",
      "description": "Enter the kernel name (e.g., vector_add_kernel)",
    },
    {
      "id": "power_consumption_joules",
      "type": "promptString",
      "description": "Enter the power consumption in joules (e.g., 0.5)",
    }
  ],
  "tasks": [
  {
    "label": "PTX: Run application",
    "type": "shell",
    "command": "uv run experiments/tools/runner.py ${input:cuda_path} --run-args ${input:cuda_args}",
    "problemMatcher": []
  },
	{
	  "label": "PTX: Create artifact",
	  "type": "shell",
	  "command": "uv run experiments/tools/artifact.py experiments/build/${input:app_name}/ experiments/apps/${input:app_name}/",
	  "problemMatcher": []
	},
	{
	  "label": "PTX: Create plot",
	  "type": "shell",
	  "command": "uv run experiments/tools/plotter.py ${input:artifact_path}/",
	  "problemMatcher": []
	},
  {
    "label": "PTX: Create analysis",
    "type": "shell",
    "command": "cargo run --manifest-path ptx-analyser/Cargo.toml analyze-cfg --kernel-params '${input:kernel_params}' ${input:ptx_path}",
    "problemMatcher": []
  },
  {
    "label": "PTX: Create Control Flow Graph",
    "type": "shell",
    "command": "cargo run --manifest-path ptx-analyser/Cargo.toml build-cfg ${input:ptx_path}  --html-output ${input:artifact_path}/cfg.html",
    "problemMatcher": []
  },
  {
    "label": "PTX: Run CUDA file with big-chain",
    "type": "shell",
    "command": "uv run big-chain.py ${input:cuda_path} --csv-kernel-name ${input:app_name} --csv-power-consumption-joules ${input:power_consumption_joules} --args ${input:cuda_args}",
    "problemMatcher": []
  },
  {
    "label": "PTX: Power metrics from CSV",
    "type": "shell",
    "command": "uv run experiments/tools/power.py ${input:artifact_path}",
    "problemMatcher": []
  },
  {
    "label": "PTX: Run Bentr from a configuration file",
    "type": "shell",
    "command": "uv run experiments/tools/bentr.py ${input:bentr_config}",
    "problemMatcher": []
  },
  {
    "label": "PTX: Run Linear Model",
    "type": "shell",
    "command": "uv run linear-model/linear-model.py",
    "problemMatcher": []
  }
  ]
}