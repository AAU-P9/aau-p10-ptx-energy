{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "app_name",
      "type": "promptString",
      "description": "Enter the name of the application (e.g., vector_add)"
    },
    {
      "id": "artifact_name",
      "type": "promptString",
      "description": "Enter the name for the artifact (e.g., vector_add_bundle_...)"
    }
  ],
  "tasks": [
    {
      "label": "PTX: Run application",
      "type": "shell",
      "command": "uv run tools/runner.py apps/${input:app_name}/",
      "problemMatcher": []
    },
	{
	  "label": "PTX: Create artifact",
	  "type": "shell",
	  "command": "uv run tools/artifact.py build/${input:app_name}/",
	  "problemMatcher": []
	},
	{
	  "label": "PTX: Create plot",
	  "type": "shell",
	  "command": "uv run tools/plotter.py artifacts/${input:artifact_name}/",
	  "problemMatcher": []
	},
  {
    "label": "PTX: Create analysis",
    "type": "shell",
    "command": "cargo run --manifest-path ./ptx-analyser/Cargo.toml analyze-cfg artifacts/${input:artifact_name}/main.ptx",
    "problemMatcher": []
  },
  {
    "label": "PTX: Create Control Flow Graph",
    "type": "shell",
    "command": "cargo run --manifest-path ./ptx-analyser/Cargo.toml build-cfg artifacts/${input:artifact_name}/main.ptx --html-output artifacts/${input:artifact_name}/cfg.html",
    "problemMatcher": []
  }
  ]
}